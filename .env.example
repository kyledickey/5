# Local development defaults for `docker compose up -d`.
DATABASE_DSN=quack:quack@tcp(127.0.0.1:3306)/quack?charset=utf8mb4&parseTime=True&loc=Local
REDIS_URL=redis://127.0.0.1:6379/0

# Required when running the app with `docker compose --profile app up`.
ENVIRONMENT=dev
API_PORT=8080
OPS_STATUS_TOKEN=
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_TRUSTED_PROXIES=
API_MAX_BODY_BYTES=1048576
API_READ_HEADER_TIMEOUT_SECONDS=5
API_READ_TIMEOUT_SECONDS=15
API_WRITE_TIMEOUT_SECONDS=30
API_IDLE_TIMEOUT_SECONDS=60
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8080/auth/discord/callback
DISCORD_OAUTH_SCOPES=identify guilds
DISCORD_COMMAND_GUILD_ID=
DISCORD_COMMAND_PRUNE=false

AUTH_SESSION_COOKIE_NAME=quack_session
AUTH_CSRF_COOKIE_NAME=quack_csrf
AUTH_SESSION_TTL_HOURS=168
AUTH_STATE_TTL_MINUTES=10
AUTH_POST_LOGIN_REDIRECT=/
AUTH_COOKIE_SECURE=false
RATE_LIMIT_OAUTH_MAXIMUM=20
RATE_LIMIT_OAUTH_WINDOW_SECONDS=600
RATE_LIMIT_MEMBER_READ_MAXIMUM=120
RATE_LIMIT_MEMBER_READ_WINDOW_SECONDS=60
RATE_LIMIT_TEMPLATE_WRITE_MAXIMUM=30
RATE_LIMIT_TEMPLATE_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_CASE_CREATE_MAXIMUM=20
RATE_LIMIT_CASE_CREATE_WINDOW_SECONDS=60
RATE_LIMIT_RETRY_MAXIMUM=10
RATE_LIMIT_RETRY_WINDOW_SECONDS=60
RATE_LIMIT_EVIDENCE_MAXIMUM=20
RATE_LIMIT_EVIDENCE_WINDOW_SECONDS=60
HTTP_IDEMPOTENCY_TTL_HOURS=24
EVENT_QUEUE_SIZE=1000
EVENT_QUEUE_WORKERS=3
